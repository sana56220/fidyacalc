<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- انٹرنیٹ پرمیشن جان بوجھ کر نہیں: ایپ مکمل آف لائن ہے۔
         فائل محفوظ/شیئر کے لیے بھی کسی اجازت کی ضرورت نہیں (Downloads میں MediaStore سے محفوظ ہوتی ہے) -->

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="Fidya Calculator"
        android:supportsRtl="true"
        android:theme="@style/Theme.FidyaCalc">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|uiMode|density|fontScale|layoutDirection|locale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
